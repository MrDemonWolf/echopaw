<section class="app" aria-label="EchoPaw dashboard prototype">
  <aside aria-label="Example sidebar">
    <strong>EchoPaw</strong>
    <ul>
      <li aria-current="page">Dashboard</li>
      <li>Character</li>
      <li>The Brain</li>
      <li>Reactions</li>
      <li>OBS Setup</li>
    </ul>
  </aside>
  <div class="workspace">
    <header>
      <div><span>Private preview</span><h2>Dashboard</h2></div>
      <button type="button" id="preview-stop" class="stop">Emergency stop</button>
    </header>
    <div class="stage" aria-label="Simulated speech indicator">
      <div class="wave" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </div>
      <p id="preview-status" role="status">Ready for a test reaction.</p>
    </div>
    <div class="actions">
      <button type="button" id="preview-reaction">Simulate reaction</button>
      <button type="button" id="preview-mute" aria-pressed="false">Mute speech</button>
      <button type="button" id="preview-resume" hidden>Resume preview</button>
    </div>
    <dl>
      <div><dt>Reaction mode</dt><dd>Balanced</dd></div>
      <div><dt>Microphone</dt><dd>Off</dd></div>
      <div><dt>Twitch</dt><dd>Disconnected</dd></div>
    </dl>
  </div>
</section>

<script>
  const reaction = document.querySelector<HTMLButtonElement>("#preview-reaction");
  const mute = document.querySelector<HTMLButtonElement>("#preview-mute");
  const stop = document.querySelector<HTMLButtonElement>("#preview-stop");
  const resume = document.querySelector<HTMLButtonElement>("#preview-resume");
  const status = document.querySelector<HTMLElement>("#preview-status");
  const stage = status?.closest<HTMLElement>(".stage");

  if (reaction && mute && stop && resume && status && stage) {
    let playback: ReturnType<typeof setTimeout> | undefined;
    const show = (message: string, speaking = false) => {
      status.textContent = message;
      stage.classList.toggle("speaking", speaking);
    };
    const clearPlayback = () => clearTimeout(playback);

    reaction.addEventListener("click", () => {
      clearPlayback();
      if (mute.getAttribute("aria-pressed") === "true") {
        show("Silent reaction. Speech is muted.");
        return;
      }
      show("Simulating mascot speech.", true);
      playback = setTimeout(() => show("Test reaction finished."), 1600);
    });

    mute.addEventListener("click", () => {
      clearPlayback();
      const muted = mute.getAttribute("aria-pressed") !== "true";
      mute.setAttribute("aria-pressed", String(muted));
      show(muted ? "Speech muted." : "Speech unmuted.");
    });

    stop.addEventListener("click", () => {
      clearPlayback();
      mute.setAttribute("aria-pressed", "true");
      reaction.disabled = true;
      mute.disabled = true;
      resume.hidden = false;
      show("Stopped. Resume preview to restore the controls.");
    });

    resume.addEventListener("click", () => {
      reaction.disabled = false;
      mute.disabled = false;
      resume.hidden = true;
      show("Preview resumed. Speech is still muted.");
      reaction.focus();
    });
  }
</script>

